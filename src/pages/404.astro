---
import BaseLayout from '../layouts/BaseLayout.astro'
const description = 'La página que se busca no se encuentra registrada en TestCorp'
const title = 'TestCorp - Error'
---

<BaseLayout {description} {title}>
	<h1 class="font-bold text-center bg-primario text-white text-3xl md:text-4xl px-4 py-12 font-titulos">
		La página consultada no fue encontrada
	</h1>
	<div class="py-16 px-4 text-center">
		<a
			href="/"
			class="font-bold py-2 px-4 rounded inline-block transition bg-primario text-white hover:bg-secundario"
		>
			Inicio
		</a>
	</div>
</BaseLayout>
