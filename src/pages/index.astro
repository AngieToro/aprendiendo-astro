---
import BaseLayout from '../layouts/BaseLayout.astro'
import InfoCard from '../components/InfoCard.astro'
import TeamTicker from '../components/TeamTicker.astro'
import SectionTitle from '../components/SectionTitle.astro'
import Button from '../components/Button.astro'
import FaqItem from '../components/FaqItem.astro'
import StackCard from '../components/StackCard.astro'
import { services } from '../data/services.ts'
import { members } from '../data/teams.ts'
import { mailtoUrl, whatsappUrl } from '../data/contact.ts'
import { purpose, values } from '../data/values.ts'
import { questions } from '../data/faq.ts'
import { Image } from 'astro:assets'
import misionImg from '../assets/mision.jpg'

const description = 'Consultora TI que ayuda a pymes a visualizar su negocio'
---

<BaseLayout {description} title="TestCorp">
	<section id="inicio" class="bg-primario text-white px-4 py-16 text-center">
		<h1 class="font-bold text-3xl md:text-4xl font-titulos">
			<span class="block">Bienvenidos</span>
			<span class="block">TestCorp te permite visualizar tu negocio</span>
		</h1>
	</section>

	<section id="nosotros" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Quiénes somos" />
		<p class="max-w-2xl mx-auto text-center text-slate-600">
			Somos un equipo de consultores TI que acompaña a pymes en su transformación digital.
		</p>
	</section>

	<section id="mision" class="py-8 px-4 relative overflow-hidden scroll-mt-20">
		<Image
			src={misionImg}
			alt=""
			widths={[640, 1280, 1920]}
			sizes="100vw"
			class="absolute inset-0 w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-primario/80" aria-hidden="true"></div>
		<div class="relative">
			<SectionTitle title="Misión y visión" light />
			<div class="grid gap-4 md:grid-cols-2 max-w-4xl mx-auto mb-12">
				{purpose.map((item) => (
					<InfoCard {...item} variant="vidrio" />
				))}
			</div>
			<SectionTitle title="Valores" light />
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 max-w-4xl mx-auto">
				{values.map((value) => (
					<InfoCard {...value} variant="vidrio" />
				))}
			</div>
		</div>
	</section>

	<section id="equipo" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Equipo" />
		<TeamTicker {members} />
	</section>

	<section id="servicios" class="py-8 px-4 bg-fondo scroll-mt-20">
		<SectionTitle title="Nuestros servicios" />
		<div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto *:w-full sm:*:w-72">
			{services.map((service, index) => (
				<StackCard {...service} index={index} total={services.length} />
			))}
		</div>
	</section>

	<section id="preguntas" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Preguntas y respuestas" />
		<div class="max-w-2xl mx-auto space-y-3">
			{questions.map((item) => (
				<FaqItem {...item} />
			))}
		</div>
	</section>

	<section id="contacto" class="py-8 px-4 bg-fondo scroll-mt-20">
		<SectionTitle title="Contáctanos" />
		<p class="max-w-2xl mx-auto text-center text-slate-600">Escríbenos</p>
		<div class="flex flex-wrap justify-center gap-4 mt-6">
			<Button label="Enviar correo" href={mailtoUrl} />
			<Button
				label="Escribir por WhatsApp"
				href={whatsappUrl}
				variant="acento"
				target="_blank"
				rel="noopener noreferrer"
			/>
		</div>
	</section>
</BaseLayout>
