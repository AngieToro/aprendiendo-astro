---
import BaseLayout from '../layouts/BaseLayout.astro'
import InfoCard from '../components/InfoCard.astro'
import TeamCard from '../components/TeamCard.astro'
import SectionTitle from '../components/SectionTitle.astro'
import { services } from '../data/services.ts'
import { members } from '../data/teams.ts'
import { mailtoUrl, whatsappUrl } from '../data/contact.ts'
import { purpose, values } from '../data/values.ts'

const description = 'Consultora TI que ayuda a pymes a visualizar su negocio'
---

<BaseLayout {description} title="TestCorp">
	<section id="inicio" class="bg-primario text-white px-4 py-16 text-center">
		<h1 class="font-bold text-3xl md:text-4xl font-titulos">
			<span class="block">Bienvenidos</span>
			<span class="block">TestCorp te permite visualizar tu negocio</span>
		</h1>
	</section>

	<section id="nosotros" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Quiénes somos" />
		<p class="max-w-2xl mx-auto text-center text-slate-600">
			Somos un equipo de consultores TI que acompaña a pymes en su transformación digital.
		</p>
	</section>

	<section id="mision" class="py-8 px-4 bg-fondo scroll-mt-20">
		<SectionTitle title="Misión, visión y valores" />
		<div class="grid gap-4 md:grid-cols-2 max-w-4xl mx-auto mb-4">
			{purpose.map((item) => (
				<InfoCard {...item} />
			))}
		</div>
		<h3 class="text-center font-semibold text-primario font-titulos mt-8 mb-4">Valores</h3>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 max-w-4xl mx-auto">
			{values.map((value) => (
				<InfoCard {...value} />
			))}
		</div>
	</section>

	<section id="equipo" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Equipo" />
		<div class="grid gap-4 grid-cols-2 md:grid-cols-3 max-w-4xl mx-auto">
			{members.map((member) => (
				<TeamCard {...member} />
			))}
		</div>
	</section>

	<section id="servicios" class="py-8 px-4 bg-fondo scroll-mt-20">
		<SectionTitle title="Nuestros servicios" />
		<div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto *:w-full sm:*:w-72">
			{services.map((service) => (
				<InfoCard {...service} />
			))}
		</div>
	</section>

	<section id="contacto" class="py-8 px-4 scroll-mt-20">
		<SectionTitle title="Contáctanos" />
		<p class="max-w-2xl mx-auto text-center text-slate-600">Escríbenos</p>
		<div class="flex flex-wrap justify-center gap-4 mt-6">
			<a
				href={mailtoUrl}
				class="px-6 py-3 rounded-md font-bold bg-primario text-white shadow-sm hover:bg-primario-hover transition"
			>
				Enviar correo
			</a>
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="px-6 py-3 rounded-md font-bold bg-acento text-primario shadow-sm hover:opacity-90 transition"
			>
				Escribir por WhatsApp
			</a>
		</div>
	</section>
</BaseLayout>
