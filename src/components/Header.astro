---
// Header del sitio: logo a la izquierda, menú de anclas a la derecha.
// En celular el menú se oculta detrás de un botón hamburguesa (ver <script> al final).
import Logo from './Logo.astro'
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-10">
	<div class="flex flex-wrap items-center justify-between px-4 py-4">
		<a href="/">
			<Logo />
		</a>

		<!-- Botón hamburguesa: solo en celular (md:hidden) -->
		<button
			id="menu-boton"
			type="button"
			class="md:hidden p-2 text-primario cursor-pointer"
			aria-expanded="false"
			aria-controls="menu"
		>
			<span class="sr-only">Abrir menú</span>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>

		<!-- Menú: oculto en celular (hidden) hasta que se abre; siempre visible desde md -->
		<nav id="menu" aria-label="Menú principal" class="hidden md:block w-full md:w-auto">
			<ul class="flex flex-col md:flex-row gap-4 md:gap-6 pt-4 md:pt-0">
				<li>
					<a
						href="/#inicio"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Inicio
					</a>
				</li>
				<li>
					<a
						href="/#nosotros"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Nosotros
					</a>
				</li>
				<li>
					<a
						href="/#servicios"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Servicios
					</a>
				</li>
				<li>
					<a
						href="/#contacto"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Contacto
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	// Este código sí se envía al navegador (Astro lo procesa y lo optimiza).
	const boton = document.querySelector('#menu-boton')
	const menu = document.querySelector('#menu')

	// Solo si los dos elementos existen (evita errores si cambia un id)
	if (boton && menu) {
		// Al hacer clic en el botón: mostrar u ocultar el menú
		boton.addEventListener('click', () => {
			// toggle devuelve true si 'hidden' quedó puesta, es decir, si el menú quedó oculto
			const quedoOculto = menu.classList.toggle('hidden')
			// aria-expanded va en el BOTÓN y dice si el menú está abierto: lo contrario de oculto
			boton.setAttribute('aria-expanded', String(!quedoOculto))
		})

		// Al tocar un enlace del menú (en celular): cerrar el menú
		menu.querySelectorAll('a').forEach((enlace) => {
			enlace.addEventListener('click', () => {
				menu.classList.add('hidden')
				boton.setAttribute('aria-expanded', 'false')
			})
		})
	}
</script>
