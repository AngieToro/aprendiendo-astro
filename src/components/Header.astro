---
// Header del sitio: logo a la izquierda, menú de anclas a la derecha.
// En celular el menú se oculta detrás de un botón hamburguesa (ver <script> al final).
import Logo from './Logo.astro'
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-10">
	<div class="flex flex-wrap items-center justify-between px-4 py-4">
		<a href="/">
			<Logo />
		</a>

		<!-- Botón hamburguesa: solo en celular (md:hidden) -->
		<button
			id="menu-boton"
			type="button"
			class="md:hidden p-2 text-primario cursor-pointer"
			aria-expanded="false"
			aria-controls="menu"
		>
			<span class="sr-only">Abrir menú</span>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>

		<!-- Menú: oculto en celular (hidden) hasta que se abre; siempre visible desde md -->
		<nav id="menu" aria-label="Menú principal" class="hidden md:block w-full md:w-auto">
			<ul class="flex flex-col md:flex-row gap-4 md:gap-6 pt-4 md:pt-0">
				<li>
					<a
						href="/#inicio"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Inicio
					</a>
				</li>
				<!-- Desplegable: en celular se abre hacia abajo; desde md flota sobre la página -->
				<li class="relative">
					<button
						id="nosotros-boton"
						type="button"
						class="group flex items-center gap-1 text-primario cursor-pointer hover:underline decoration-acento decoration-2 underline-offset-4"
						aria-expanded="false"
						aria-controls="nosotros-submenu"
					>
						Nosotros
						<svg
							class="size-4 transition group-aria-expanded:rotate-180"
							viewBox="0 0 20 20"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							aria-hidden="true"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 8l5 5 5-5"></path>
						</svg>
					</button>
					<ul
						id="nosotros-submenu"
						class="hidden space-y-3 pt-3 pl-4 md:absolute md:left-0 md:top-full md:mt-2 md:w-44 md:p-3 md:bg-white md:border md:border-slate-200 md:rounded-md md:shadow-md"
					>
						<li>
							<a
								href="/#nosotros"
								class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
							>
								Quiénes somos
							</a>
						</li>
						<li>
							<a
								href="/#mision"
								class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
							>
								Misión y valores
							</a>
						</li>
						<li>
							<a
								href="/#equipo"
								class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
							>
								Equipo
							</a>
						</li>
					</ul>
				</li>
				<li>
					<a
						href="/#servicios"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Servicios
					</a>
				</li>
				<li>
					<a
						href="/#contacto"
						class="text-primario hover:underline decoration-acento decoration-2 underline-offset-4"
					>
						Contacto
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	// Menu Hamburguesa
	const boton = document.querySelector('#menu-boton')
	const menu = document.querySelector('#menu')

	// Solo si los dos elementos existen
	if (boton && menu) {
		// Al hacer clic en el botón: mostrar u ocultar el menú
		boton.addEventListener('click', () => {
			// toggle devuelve true si 'hidden' quedó puesta, es decir, si el menú quedó oculto
			const quedoOculto = menu.classList.toggle('hidden')
			// aria-expanded va en el BOTÓN y dice si el menú está abierto: lo contrario de oculto
			boton.setAttribute('aria-expanded', String(!quedoOculto))
		})

		// Al tocar un enlace del menú (en celular): cerrar el menú
		menu.querySelectorAll('a').forEach((enlace) => {
			enlace.addEventListener('click', () => {
				menu.classList.add('hidden')
				boton.setAttribute('aria-expanded', 'false')
			})
		})
	}

	// Desplegable "Nosotros" (SubMenu)
	const botonNosotros = document.querySelector('#nosotros-boton')
	const submenuNosotros = document.querySelector('#nosotros-submenu')

	// Solo si los dos elementos existen
	if (botonNosotros && submenuNosotros) {
		const cerrarSubmenu = () => {
			submenuNosotros.classList.add('hidden')
			botonNosotros.setAttribute('aria-expanded', 'false')
		}

		// Al hacer clic en el botón: mostrar u ocultar el submenú
		botonNosotros.addEventListener('click', () => {
			const submenuOculto = submenuNosotros.classList.toggle('hidden')
			botonNosotros.setAttribute('aria-expanded', String(!submenuOculto))
		})

		// Al tocar un enlace del menú: cerrar el submenú
		submenuNosotros.querySelectorAll('a').forEach((enlace) => {
			enlace.addEventListener('click', () => {
				cerrarSubmenu()
			})
		})

		// Cerrar el submenú al presionar Escape
		document.addEventListener('keydown', (evento) => {
			if (evento.key === 'Escape') {
				cerrarSubmenu()
			}
		})

		// Cerrar el submenú al hacer clic fuera del botón y del submenú
		document.addEventListener('click', (evento) => {
			const objetivo = evento.target as Node // es el elemento donde se hizo clic
			if (!botonNosotros.contains(objetivo) && !submenuNosotros.contains(objetivo)) {
				cerrarSubmenu()
			}
		})
	}
</script>
