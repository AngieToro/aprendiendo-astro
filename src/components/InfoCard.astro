---
// Tarjeta con ícono, título y texto.
// variant="vidrio": fondo blanco translúcido y desenfocado, para ponerla sobre una imagen oscura.
interface Props {
	title: string
	description: string
	icon?: string
	variant?: 'blanca' | 'vidrio'
}

const { icon, title, description, variant = 'blanca' } = Astro.props

// Cada variante cambia la caja, el título y el texto
const estilos = {
	blanca: {
		caja: 'bg-white border-secundario/30 shadow-sm',
		titulo: 'text-primario',
		texto: 'text-slate-600',
	},
	vidrio: {
		caja: 'bg-white/10 border-white/20 backdrop-blur-md',
		titulo: 'text-white',
		texto: 'text-slate-200',
	},
}

const estilo = estilos[variant]
---

<article
	data-aparecer
	class:list={[
		'p-4 text-center border rounded-lg transition hover:-translate-y-1 hover:border-acento',
		estilo.caja,
	]}
>
	<div class="flex items-center justify-center mb-2 gap-2">
		<span aria-hidden="true">{icon}</span>
		<h3 class:list={['font-semibold font-titulos', estilo.titulo]}>{title}</h3>
	</div>
	<p class:list={['text-sm', estilo.texto]}>{description}</p>
</article>
