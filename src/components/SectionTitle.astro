---
// Título de sección: h2 + línea de acento. Se usa en todas las secciones de la página.
// light: título en blanco, para secciones con fondo oscuro (ej. imagen con capa oscura).
interface Props {
	title: string
	light?: boolean
}

const { title, light = false } = Astro.props
---

<h2
	data-aparecer
	class:list={[
		'font-semibold text-center text-2xl md:text-3xl mb-4 font-titulos',
		light ? 'text-white' : 'text-primario',
	]}
>
	{title}
</h2>
<div class="w-16 h-1 bg-acento mx-auto mb-8" aria-hidden="true"></div>
