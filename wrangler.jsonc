// Configuración del deploy en Cloudflare Workers (sitio estático, sin servidor)
{
	// Nombre del proyecto: aparece en la URL. Solo minúsculas y guiones
	"name": "aprendiendo-astro-testcorp",
	// Versión de Cloudflare que usa el proyecto, con fecha en formato AAAA-MM-DD: 2026-11-05.
	"compatibility_date": "2026-11-05",
	"assets": {
		// Carpeta que genera npm run build
		"directory": "./dist",
		// Muestra la página 404 cuando una URL no existe
		"not_found_handling": "404-page",
	},
}
